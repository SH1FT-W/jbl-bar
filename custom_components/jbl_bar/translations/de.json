      "moment": { "name": "Moment" },
      "calibration": { "name": "Raum einmessen" },
      "rear": { "name": "Rear-Speaker" }
    },
    "number": {
      "volume": { "name": "Lautstärke" },
      "eq_band": { "name": "EQ {band}" },
      "audio_sync": { "name": "Audio-Sync" }
    },
    "select": {
      "eq_preset": { "name": "EQ-Preset" },
      "sleep_timer": {
        "name": "Sleep-Timer",
        "state": { "0": "Aus", "15": "15 Min.", "30": "30 Min.", "45": "45 Min.", "60": "1 Std.", "90": "1,5 Std.", "120": "2 Std." },
        "state_attributes": { "remaining_minutes": { "name": "Restminuten" } }
      }
    },
    "sensor": {
      "source": {
        "name": "Quelle",
        "state": { "tv": "TV", "hdmi": "HDMI", "bluetooth": "Bluetooth", "idle": "Keine", "other": "Andere" }
      },
      "audio_format": { "name": "Audioformat" },

{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "JBL Bar",
        "description": "IP-Adresse der Soundbar (JBL-One-App: Einstellungen → Produktinfo).",
        "data": { "host": "IP-Adresse" }
      },
      "confirm": { "description": "{name} ({host}) hinzufügen?" },
      "reconfigure": { "data": { "host": "IP-Adresse" } }
    },
    "error": {
      "cannot_connect": "Unter dieser Adresse antwortet keine Soundbar.",
      "not_jbl": "Das Gerät antwortet nicht wie eine JBL-One-Soundbar."
    },
    "abort": {
      "already_configured": "Diese Soundbar ist schon eingerichtet.",
      "cannot_connect": "Die Soundbar antwortet nicht.",
      "not_jbl": "Keine JBL-One-Soundbar.",
      "reconfigure_successful": "Adresse geändert.",
      "wrong_device": "Unter dieser Adresse antwortet eine andere Soundbar."
    }
  },
  "entity": {
    "binary_sensor": {
      "atmos_active": { "name": "Dolby Atmos" },
      "rear_charging": { "name": "Lädt" },
      "rear_docked": { "name": "Angedockt" },
      "rear_online": { "name": "Verbunden" }
    },
    "button": {
      "atmos": { "name": "Atmos-Stufe" },
